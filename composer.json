{
    "name": "fransblauw/maestro",
    "type": "framework",
    "version": "0.1",
    "autoload": {
        "psr-4": {
            "Framework\\": "src/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Services\\": "tests/Services/",
            "Repositories\\": "tests/Repositories/",
            "Middleware\\": "tests/Middleware/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4",
        "deptrac/deptrac": "^4.5",
        "phpunit/phpunit": "^13.1"
    }
}