{% extends "partials/base.html.twig" %}

{% set pageTitle = "Blog" %}

{% block content %}
    <section class="blog" id="home" data-aos="fade-in">
        <h2>Posts</h2>

        <div class="posts">
            {% for post in posts %}
                <article class="post">
                    <div class="post-image">
                        <img src="{{ post.cardImage }}" alt="{{ post.title }}">
                    </div>

                    <div class="post-text">
                        <h4>{{ post.title }}</h4>
                        <p>{{ post.excerpt }}</p>
                    </div>

                    <div class="post-footer">
                        {% if user is defined and user and user.role == 'admin' %}
                            <p class="post-status post-status-{{ post.status }}">
                                Status: {{ post.status }}
                            </p>
                        {% endif %}

                        <div class="post-actions">
                            <p>{{ post.publishedAt|date("d.m.Y") }}</p>

                            {% if user is defined and user and user.role == 'admin' %}
                                <a href="/admin/blog/edit/{{ post.slug }}">Edit</a>
                            {% endif %}

                            <a href="/blog/{{ post.slug }}">Read more</a>
                        </div>
                    </div>
                </article>
            {% else %}
                <p class="empty-posts-message">No blog posts available yet.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}