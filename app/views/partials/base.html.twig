<!doctype html>
<html lang="en">
<head>
    <title>Portfolio - {{ pageTitle }}</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="The best of best portfolio website.">
    <meta name="keywords" content="portfolio, hz, html, css">
    <meta name="author" content="Volodymyr Osychenko">
    <link rel="icon" type="image/x-icon" href="/img/hzlogo-nobg.jpg">
    <!-- styles -->
    <link rel="stylesheet" href="/res/reset.css">
    <link rel="stylesheet" href="/res/styles.css">
    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
          rel="stylesheet">
    <!-- animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
</head>
<body>
<nav class="navbar">
    <ul class="nav-links">
        <li>
            <a href="/" class="nav-links_items">Home</a>
        </li>

        <li>
            <a href="/profile" class="nav-links_items">Profile</a>
        </li>

        <li>
            <a href="/dashboard" class="nav-links_items">Progress</a>
        </li>

        <li>
            <a href="/faq" class="nav-links_items">FAQ</a>
        </li>

        <li>
            <a href="/blog" class="nav-links_items">Blog</a>
        </li>

        <li>
            <a href="/projects" class="nav-links_items">Projects</a>
        </li>

        {% if user is not defined or not user %}
            <li>
                <a href="/login" class="nav-links_items">Login</a>
            </li>
        {% else %}
            <li>
                <a href="/logout" class="nav-links_items">Logout</a>
            </li>
        {% endif %}
    </ul>
</nav>
<div>
    {% block content %}{% endblock %}
</div>
<footer data-aos="fade-up">
    <a class="footer-links" target="_blank" href="https://www.instagram.com/volosych08?igsh=NWM5em9zd2hweHg="><img
                src="/../img/instagram.png" alt="inst"></a>
    <a class="footer-links" target="_blank" href="https://github.com/volosych08"><img src="/../img/github.png" alt="github"></a>
</footer>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
    AOS.init();
</script>
</body>
</html>
