{% extends "partials/base.html.twig" %}

{% set pageTitle = "Dashboard" %}

{% block content %}

    <section class="dashboard" id="home" data-aos="fade-in">
        <div class="dashboard-topbar">
            <h2>Dashboard</h2>

            {% if user is defined and user and user.role == 'admin' %}
                <a href="/admin/dashboard/grades" class="dashboard-edit-button">
                    Edit grades
                </a>
            {% endif %}
        </div>

        <table>
            <tr>
                <td>Quartile</td>
                <td>Course</td>
                <td>Exam</td>
                <td>Exam Date</td>
                <td>Earnable Credits</td>
                <td>Grade</td>
            </tr>

            {% for assessment in assessments %}
                <tr>
                    <td>{{ assessment.quartile }}</td>

                    <td>
                        {{ assessment.courseName }} - {{ assessment.courseCode }}
                    </td>

                    <td>{{ assessment.examName }}</td>
                    <td>{{ assessment.examDate }}</td>
                    <td>{{ assessment.earnableCredits }}</td>

                    <td>
                        {% if assessment.grade is null %}
                            -
                        {% else %}
                            {{ assessment.grade }}
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">No study assessments available yet.</td>
                </tr>
            {% endfor %}
        </table>
    </section>

    <section class="progress" data-aos="fade-in">
        <h2>Progress</h2>

        <h3>Current Study Credits - {{ earnedCredits }}/{{ totalCredits }}</h3>
        <div class="progress-container">
            <div class="progress-bar" style="width: {{ progressPercentage }}%;">
                {{ earnedCredits }}
            </div>
        </div>

        <h3>Required Study Credits (NBSA) - {{ requiredCredits }}/{{ totalCredits }}</h3>
        <div class="progress-container">
            <div class="progress-bar" style="width: {{ requiredPercentage }}%;">
                {{ requiredCredits }}
            </div>
        </div>
    </section>

{% endblock %}