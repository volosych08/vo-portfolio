{% extends "partials/base.html.twig" %}

{% set pageTitle = "Profile" %}

{% block content %}
    <header class="header" id="home" data-aos="fade-in">
        <div class="header-wrap">
            <div>
                <img class="pfp" src="/img/me2.png" alt="pfp">
            </div>

            <div>
                <h1 class="header-name">Hey, I’m Volodymyr</h1>
                <p class="short-dscr">
                    Curious programmer, tech enthusiast, and lifelong learner. Always working on new
                    projects and ideas.
                </p>
            </div>

            <div class="header-links">
                <img class="header-img" src="/img/inst.png" alt="qrinst">
                <a class="about-me_btn" href="#readmore">Read more</a>

                {% if user is defined and user and user.role == 'admin' %}
                    <a class="about-me_btn" href="/admin/profile/edit">Edit profile</a>
                {% endif %}
            </div>
        </div>
    </header>

    <section class="readmore profile-editable-section" id="readmore" data-aos="fade-in">
        <h1 class="read-title">{{ aboutMe.title }}</h1>

        <p class="wict-content wict-content-profile-additional">
            {{ aboutMe.content|nl2br }}
        </p>
    </section>

    <section class="readmore profile-editable-section" data-aos="fade-in">
        <h1 class="read-title">Skills</h1>

        <div class="skills">
            <div class="why-hz">
                <ul>
                    <h2>{{ programmingSkills.title }}</h2>

                    {% for skill in programmingSkills.content|split("\n") %}
                        {% if skill|trim is not empty %}
                            <li>{{ skill }}</li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>

            <div class="why-hz">
                <ul>
                    <h2>{{ languages.title }}</h2>

                    {% for language in languages.content|split("\n") %}
                        {% if language|trim is not empty %}
                            <li>{{ language }}</li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>
    </section>
{% endblock %}